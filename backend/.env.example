# Research Agent backend environment (copy to .env; never commit .env)
# PostgreSQL. Prefer the split fields so that
# passwords with @ / ! are escaped correctly:
RA_DB_HOST=127.0.0.1
RA_DB_PORT=25432
RA_DB_USER=
RA_DB_PASSWORD=
RA_DB_NAME=research_agent

# Alternative: a full DSN (password must be URL-encoded)
# RA_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:25432/research_agent

# Optional: protect the local API when it is exposed beyond loopback
# RA_API_TOKEN=

# Optional LLM overrides (normally configured in the web UI settings page)
# RA_LLM_BASE_URL=
# RA_LLM_MODEL=
# RA_LLM_API_KEY=

# Optional: raise GitHub API rate limits (trending / search collectors)
# RA_GITHUB_TOKEN=

RA_AUTO_CREATE_TABLES=true
RA_LOG_LEVEL=INFO
